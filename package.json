{
  "name": "moneykawkaw-director",
  "version": "0.1.0",
  "private": true,
  "overrides": { "@grpc/grpc-js": "1.14.7" },
  "type": "module",
  "scripts": {
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "predev": "npm run prepare:ocr",
    "prebuild": "npm run prepare:ocr",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --exclude tests/firebase/**",
    "functions:build": "npm run build --prefix functions",
    "emulators": "npm run functions:build && firebase emulators:start --project demo-moneykawkaw --only auth,firestore,storage,functions",
    "emulators:seed": "node scripts/seed-emulators.mjs",
    "test:firebase": "npm run functions:build && firebase emulators:exec --project demo-moneykawkaw --only auth,firestore,storage,functions \"node --test --test-concurrency=1 tests/firebase/*.test.mjs\"",
    "lint": "oxlint --react-plugin --jsx-a11y-plugin --deny-warnings src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@tesseract.js-data/eng": "^1.0.0",
    "firebase": "12.19.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.35.0",
    "oxlint": "^1.91.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^5.1.0"
  }
}
