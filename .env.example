# Local emulator configuration only. Copy to .env.local; never commit private values.
VITE_DATA_MODE=emulator
VITE_FIREBASE_PROJECT_ID=demo-moneykawkaw
VITE_FIREBASE_API_KEY=emulator-only
VITE_FIREBASE_AUTH_DOMAIN=demo-moneykawkaw.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-moneykawkaw.appspot.com
VITE_FIREBASE_APP_ID=emulator-only
VITE_FIREBASE_REGION=us-central1
# firebase mode requires the authorized project's values; demo is local-only.
