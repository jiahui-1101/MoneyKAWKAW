# Local Supabase values from `npm run supabase:status` (public anon key only).
VITE_DATA_MODE=local
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_LOCAL_TEST_LOGIN=false

# Optional local Google OAuth. Obtain credentials from Google Cloud Console;
# do not commit the configured values in .env.local.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Optional trained receipt semantics; Members opt in before reading. Use off for fallback testing.
VITE_RECEIPT_MODEL=on
# Optional experimental simulation-trained financial model; set off to disable.
VITE_PRESSURE_MODEL=on
